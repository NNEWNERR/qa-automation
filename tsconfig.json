{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,        // บังคับ type safety เต็มรูปแบบ
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": { "@types/*": ["types/*"] },
    "types": ["node"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}