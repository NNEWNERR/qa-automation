{
  "name": "qa-automation",
  "version": "1.0.0",
  "description": "Playwright + TypeScript test automation portfolio \u2014 API, UI, a11y and visual regression, sharded in CI.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:ci": "playwright test --grep-invert @visual",
    "test:smoke": "playwright test --project=smoke",
    "test:api": "playwright test --project=api-tests --project=user-crud-tests",
    "test:ui": "playwright test --project=ui-tests",
    "test:a11y": "playwright test --project=a11y-tests",
    "test:visual": "playwright test --project=visual-tests",
    "test:login": "playwright test --project=login-tests",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:update-snapshots": "playwright test --project=visual-tests --update-snapshots",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "keywords": [],
  "author": "Supakorn (NNEWNERR)",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@faker-js/faker": "^10.4.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3"
  }
}
